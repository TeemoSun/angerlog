# docker compose 部署配置（生产环境）
# 复制为 .env 并修改所有值后，执行 docker compose up -d

# PostgreSQL
POSTGRES_USER=app_user
POSTGRES_PASSWORD=change-me
POSTGRES_DB=emotion_bottle

# 单用户凭证 (bcrypt cost=12)
USERNAME=admin
PASSWORD_HASH=$2b$12$CHANGE_ME

# 用户默认时区
USER_TIMEZONE=Asia/Shanghai

# JWT
SECRET_KEY=change-me-secret
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# 安全
CSRF_SECRET=change-me-csrf
LOGIN_RATE_LIMIT=5/5minutes
CORS_ORIGINS=http://localhost:8000
