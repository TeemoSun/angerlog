# 复制为 .env 并修改所有值后使用
# 本地开发/源码部署与 docker compose 部署共用此文件：
# - DATABASE_URL/PASSWORD/FRONTEND_DIST 等：后端（uvicorn）直接读取
# - POSTGRES_USER/POSTGRES_PASSWORD/POSTGRES_DB：仅 docker compose 的 db 服务使用

# Database（本地开发示例：localhost:54329；docker compose 部署时由 backend 服务内拼接覆盖）
DATABASE_URL=postgresql+asyncpg://app_user:change-me@localhost:5432/emotion_bottle

# docker compose 部署的 PostgreSQL（仅 db 服务使用；后端 DATABASE_URL 由 compose 自动拼接）
POSTGRES_USER=app_user
POSTGRES_PASSWORD=change-me
POSTGRES_DB=emotion_bottle

# 单用户凭证（明文密码，应用启动时自动 bcrypt 哈希后 upsert 到数据库）
USERNAME=admin
PASSWORD=change-me

# 用户默认时区（IANA 名，如 Asia/Shanghai / America/New_York；数据库存 UTC，
# 统计的周/日边界与前端时间展示均按此时区换算，登录时下发给前端）
USER_TIMEZONE=Asia/Shanghai

# JWT
SECRET_KEY=change-me-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# 安全
CSRF_SECRET=change-me-csrf
LOGIN_RATE_LIMIT=5/5minutes
CORS_ORIGINS=http://localhost:8000

# 前端构建产物路径（后端静态托管；容器内为 /app/frontend/dist）
FRONTEND_DIST=/app/frontend/dist
