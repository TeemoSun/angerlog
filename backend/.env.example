# Database
DATABASE_URL=postgresql+asyncpg://app_user:change-me@localhost:5432/emotion_bottle

# 单用户凭证 (bcrypt cost=12)
USERNAME=admin
PASSWORD_HASH=$2b$12$CHANGE_ME

# 用户默认时区
USER_TIMEZONE=Asia/Shanghai

# JWT
SECRET_KEY=change-me-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# 安全
CSRF_SECRET=change-me-csrf
LOGIN_RATE_LIMIT=5/5minutes
CORS_ORIGINS=http://localhost:5173

# 前端构建产物路径（后端静态托管；容器内为 /app/frontend/dist）
FRONTEND_DIST=/app/frontend/dist
